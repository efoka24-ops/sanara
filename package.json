{
  "name": "sanara",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @sanara/web dev",
    "build:web": "pnpm --filter @sanara/web build",
    "test": "pnpm -r --if-present test",
    "lint": "eslint \"{apps,packages}/*/src/**/*.{ts,tsx}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "prepare": "husky",
    "format": "prettier --write .",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@playwright/test": "^1.65.1",
    "eslint": "^9.15.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0"
  }
}
