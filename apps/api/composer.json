{
  "name": "sanara/api",
  "description": "API Sanara (Slim 4, PHP 8.1, MySQL 8)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "slim/slim": "^4.14",
    "slim/psr7": "^1.7",
    "php-di/php-di": "^7.0",
    "vlucas/phpdotenv": "^5.6",
    "firebase/php-jwt": "^7.0",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "Sanara\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Sanara\\Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.1.34"
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
